# Copy to .env and adjust. .env is gitignored; never commit real secrets.

# Dev server ports. `openscaffold verify` and the Makefile read these.
PORT_API=8000
PORT_WEB=5173

# Backend settings (pydantic-settings reads these; see backend/app/config.py)
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173"]

# Frontend (only VITE_-prefixed vars reach the browser, baked in at build time)
# Leave empty in dev to use the /api proxy; set when the API is on another origin.
VITE_API_BASE_URL=
