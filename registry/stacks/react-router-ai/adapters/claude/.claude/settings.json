{
  "permissions": {
    "allow": [
      "Bash(bun run lint)",
      "Bash(bun run format)",
      "Bash(bun run typecheck)",
      "Bash(bun run test)",
      "Bash(bun run coverage)",
      "Bash(bun run test *)",
      "Bash(bunx vitest run)",
      "Bash(bunx vitest run *)",
      "Bash(bun run build)",
      "Bash(bun run check)",
      "Bash(bun run e2e)",
      "Bash(curl -s localhost:5173/*)",
      "Bash(curl -s http://localhost:5173/*)",
      "Bash(bun run dev:bg)",
      "Bash(bun run dev:stop)",
      "Bash(curl -si localhost:5173/*)",
      "Bash(curl -si http://localhost:5173/*)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.local)"]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/dev-server-status.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-commands.sh\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-generated.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guard-server-imports.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/hooks/typecheck-on-write.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
