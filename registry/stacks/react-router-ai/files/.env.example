# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# bun loads .env for every `make` target (they all go through `bun run`).

# Dev server port. `openscaffold verify` and the Makefile read this.
PORT_WEB=5173

# OpenRouter. Chat is off (the UI says "not configured") while the key is empty.
OPENROUTER_API_KEY=
# Default model id, used when a request doesn't pick one.
OPENROUTER_MODEL=
# System prompt override; empty uses app/.server/prompts.ts.
SYSTEM_PROMPT=

# Routing (all optional). Comma-separated fallback model ids, tried in order.
OPENROUTER_FALLBACK_MODELS=
# Provider sort: price, throughput, or latency. Empty lets OpenRouter decide.
OPENROUTER_PROVIDER_SORT=
OPENROUTER_ALLOW_FALLBACKS=true
# allow or deny. deny only routes to providers that don't store prompts.
OPENROUTER_DATA_COLLECTION=allow

# Limits
RATE_LIMIT_CAPACITY=20
RATE_LIMIT_REFILL_PER_MINUTE=20
MAX_CONCURRENT_STREAMS=8
MAX_INPUT_CHARS=8000
MAX_MESSAGES=50
MAX_OUTPUT_TOKENS=1024
MAX_TOOL_STEPS=5
MAX_STREAM_SECONDS=120
