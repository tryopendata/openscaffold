# {{project_name}} development commands.
#
# A starting point: adapt the recipes, but keep the target names.
# `openscaffold verify` calls install, lint, typecheck, test, build and dev,
# and CI should call the same targets. Every target goes through `bun run`,
# which loads .env into the script's environment.

PORT_WEB ?= 5173
export PORT_WEB

.DEFAULT_GOAL := help
.PHONY: help install dev start lint format typecheck test coverage build clean

help: ## List targets
	@grep -E '^[a-zA-Z0-9_-]+:.*?## ' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "  %-12s %s\n", $$1, $$2}'

install: ## Install dependencies (frozen lockfile when CI is set)
	bun install $(if $(CI),--frozen-lockfile)

dev: ## Dev server on PORT_WEB (foreground)
	bun run dev --port $(PORT_WEB) --strictPort

start: build ## Serve the production build on PORT_WEB
	PORT=$(PORT_WEB) bun run start

lint: ## Biome lint and format check
	bun run lint

format: ## Biome format and safe fixes
	bun run format

typecheck: ## React Router typegen + tsc
	bun run typecheck

test: ## vitest run
	bun run test

coverage: ## Tests with coverage
	bun run test --coverage

build: ## Production build into build/
	bun run build

clean: ## Remove build output and caches
	rm -rf build .react-router coverage
