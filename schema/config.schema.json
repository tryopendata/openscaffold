{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "always": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "agents": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "claude",
          "codex",
          "opencode",
          "cursor"
        ]
      }
    },
    "author": {
      "type": "string"
    },
    "package_scope": {
      "type": "string"
    },
    "preset": {
      "default": "default",
      "type": "string",
      "enum": [
        "default",
        "sandbox"
      ]
    },
    "registry": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
